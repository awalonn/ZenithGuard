{
  "manifest_version": 3,
  "name": "ZenithGuard",
  "version": "3.3.2",
  "description": "Advanced AI-powered Ad Blocker and Privacy Guard",
  "default_locale": "en",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "tabs",
    "alarms",
    "webRequest",
    "webNavigation",
    "contextMenus"
  ],
  "optional_permissions": [
    "browsingData"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "core_protection",
        "enabled": false,
        "path": "rules/core_protection.json"
      },
      {
        "id": "youtube_core",
        "enabled": false,
        "path": "rules/youtube_core.json"
      }
    ]
  },
  "action": {
    "default_popup": "src/pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-zapper": {
      "suggested_key": {
        "default": "Alt+Shift+Z",
        "mac": "Alt+Shift+Z"
      },
      "description": "Activate/Deactivate Element Zapper"
    },
    "open-logger": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Open Network Logger"
    },
    "open-settings": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open Dashboard/Settings"
    }
  },
  "options_page": "src/pages/settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "css/theme.css",
        "js/yt_interceptor.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/page_popup_guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "css/content.css",
        "css/toast.css"
      ],
      "js": [
        "js/content_bundle.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
