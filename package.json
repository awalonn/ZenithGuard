{
  "name": "zenithguard",
  "version": "3.3.2",
  "description": "ZenithGuard - Advanced AI Ad & Privacy Blocker",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/awalonn/ZenithGuard.git"
  },
  "scripts": {
    "check:dnr": "node scripts/check_dnr_rules.mjs",
    "check:surface": "node scripts/check_extension_surface.mjs && npm run check:dnr",
    "check:dist": "node scripts/check_dist_surface.mjs dist",
    "check:types": "svelte-check",
    "capture:store": "node scripts/capture_store_screenshots.mjs",
    "scan:live": "node scripts/live_ad_scan.mjs",
    "build": "vite build && node scripts/build_auxiliary_entries.mjs dist",
    "build:firefox": "vite build --outDir dist-firefox && node scripts/build_auxiliary_entries.mjs dist-firefox && node scripts/build_firefox_manifest.cjs dist-firefox/manifest.json",
    "watch": "vite build --watch",
    "release": "node release.js",
    "test": "node --max-old-space-size=8192 --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:smoke": "npm run check:surface && node --max-old-space-size=8192 --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --runInBand && node --max-old-space-size=8192 --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.js tests/e2e --runInBand",
    "test:unit": "node --max-old-space-size=8192 --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --max-old-space-size=8192 --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",
    "test:e2e": "node --max-old-space-size=8192 --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/chrome": "^0.1.32",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "archiver": "^8.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "puppeteer": "^25.4.0",
    "semver": "^7.7.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-static-copy": "^3.1.4"
  }
}
